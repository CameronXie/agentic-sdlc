{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["examples/*/AGENTS.md"],
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git merge-base*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git commit --amend*": "deny",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git push*": "ask",
      "git merge*": "ask",
      "ls *": "allow",
      "which *": "allow",
      "tree *": "allow",
      "jq *": "allow",
      "make help*": "allow",
      "make lint*": "allow",
      "make format*": "allow",
      "make format-check*": "allow",
      "make test*": "allow",
      "make ci*": "allow",
      "make security*": "allow",
      "make install*": "allow",
      "make build*": "allow",
      "make clean*": "allow",
      "make verify*": "allow",
      "make smoke*": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "go fmt*": "allow",
      "gofmt *": "allow",
      "goimports *": "allow",
      "golangci-lint *": "allow",
      "govulncheck *": "allow",
      "shellcheck *": "allow",
      "actionlint *": "allow",
      "go tool *": "allow",
      "scripts/verify.sh*": "allow",
      "./scripts/verify.sh*": "allow",
      "scripts/lint-repo.sh*": "allow",
      "./scripts/lint-repo.sh*": "allow",
      "scripts/verify-all.sh*": "allow",
      "./scripts/verify-all.sh*": "allow",
      "go get*": "ask",
      "go mod*": "ask",
      "openspec list*": "allow",
      "openspec status*": "allow",
      "openspec show*": "allow",
      "openspec validate*": "allow",
      "openspec instructions*": "allow",
      "openspec context*": "allow",
      "openspec doctor*": "allow",
      "openspec templates*": "allow",
      "openspec schemas*": "allow",
      "openspec new change*": "allow",
      "openspec archive*": "ask",
      "openspec init*": "ask",
      "openspec update*": "ask",
      "openspec config*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny"
    },
    "edit": {
      "*": "ask",
      "*.md": "allow",
      "*.go": "allow",
      "go.mod": "ask",
      "go.sum": "ask"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "mcp": {}
}
